    {
      "name": "calendar",
      "type": "registry:ui",
      "title": "Calendar",
      "description": "A month grid for picking a date or a date range, always visible on the page.",
      "dependencies": [
        "react-aria-components@^1.21.0",
        "@internationalized/date@^3.12.0",
        "@tabler/icons-react@^3.30.0"
      ],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/strata/ui/calendar.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/strata/ui/calendar.module.css",
          "type": "registry:ui"
        }
      ],
      "categories": [
        "inputs"
      ],
      "docs": "Strata components read --strata-* tokens. Install them once: npx shadcn@latest add http://localhost:3000/r/strata.json",
      "meta": {
        "maturity": "beta",
        "exports": [
          "Calendar",
          "RangeCalendar"
        ]
      }
    },
