# Cloudflare Pages reads this from the deployed root. Next copies apps/docs/public/* into the export unchanged.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  # The docs site has no forms, no auth and no third-party scripts. Fonts come from Google Fonts; everything
  # else is same-origin. style-src needs 'unsafe-inline' because /themes writes a generated theme into a
  # <style> tag on every keystroke, and each preview scopes its own tokens the same way.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'

# No path needs 'unsafe-eval'. The server-driven UI demo used to, because ajv compiled its schemas in the browser
# with `new Function`; they are compiled at build time now (ADR-034), so one rule covers the whole site. Scoping an
# exception to that one path would not have worked anyway: Cloudflare Pages sends every matching rule's header, and
# a browser given two Content-Security-Policy headers enforces both, so the stricter one still wins.

# Hashed assets: the name changes when the bytes do, so they can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
