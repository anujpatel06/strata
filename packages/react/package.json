{
  "name": "@syntara/react",
  "version": "0.1.0",
  "description": "Syntara React components — React Aria behaviour, Syntara tokens, any brand.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anujpatel06/strata.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/anujpatel06/strata/tree/main/packages/react#readme",
  "bugs": "https://github.com/anujpatel06/strata/issues",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./ui/*": "./src/ui/*.tsx"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ui/*": {
        "types": "./dist/types/ui/*.d.ts",
        "default": "./dist/ui/*.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    },
    "types": "./dist/types/index.d.ts"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "gen:index": "node scripts/gen-index.mjs",
    "build": "vite build",
    "registry": "node scripts/build-registry.mjs",
    "check:meta": "node scripts/check-meta.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.0",
    "@syntara/icons": "workspace:*",
    "react-aria-components": "^1.21.0"
  },
  "devDependencies": {
    "@syntara/theme-engine": "workspace:*",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.0",
    "vite": "^8.0.0"
  }
}
