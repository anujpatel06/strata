{
  "name": "@syntara/icons",
  "version": "0.1.0",
  "description": "Syntara's own icon set: curvy, minimal outline icons on a 24px grid. React components; colour follows text, stroke follows the --syntara-icon-stroke token.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anujpatel06/syntara.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/anujpatel06/syntara/tree/main/packages/icons#readme",
  "bugs": "https://github.com/anujpatel06/syntara/issues",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "sheet": "tsx scripts/sheet.tsx",
    "sheet:batch": "tsx scripts/sheet-batch.tsx",
    "check:tints": "tsx scripts/check-tint-overlap.tsx"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "icons",
    "react",
    "svg",
    "icon-set",
    "duotone",
    "design-system"
  ]
}
