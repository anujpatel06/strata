{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:syntara:sdui:v1:node:Text",
  "title": "Text",
  "description": "A paragraph of body text. The schema's own text node.",
  "x-syntara": {
    "node": "Text",
    "component": null,
    "export": null,
    "maturity": "alpha",
    "schemaVersion": "1.1.0",
    "source": "sdui"
  },
  "type": "object",
  "required": [
    "type",
    "children"
  ],
  "properties": {
    "type": {
      "const": "Text"
    },
    "id": {
      "$ref": "urn:syntara:sdui:v1:defs#/$defs/NodeId"
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "description": "Font size token.",
          "type": "string",
          "enum": [
            "xs",
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        },
        "tone": {
          "description": "default = text.default; subtle = text.subtle, for secondary lines.",
          "type": "string",
          "enum": [
            "default",
            "subtle"
          ],
          "default": "default"
        },
        "weight": {
          "description": "Font weight token.",
          "type": "string",
          "enum": [
            "regular",
            "medium",
            "semibold"
          ],
          "default": "regular"
        },
        "numeric": {
          "description": "Tabular figures, for amounts and counts that line up.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "children": {
      "description": "On the wire: a string.",
      "type": "string"
    },
    "fallback": {
      "description": "Rendered instead of this node by a client that doesn't know its type. Must be a node that client knows.",
      "$ref": "urn:syntara:sdui:v1:screen#/$defs/Node"
    }
  },
  "additionalProperties": false
}
