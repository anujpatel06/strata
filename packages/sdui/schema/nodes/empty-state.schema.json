          "description": "sm for cards, tables and popovers; md for pages and sections.",
          "type": "string",
          "enum": [
            "sm",
            "md"
          ],
          "default": "md"
        },
        "level": {
          "description": "Heading level of the title.",
          "type": "integer",
          "enum": [
            2,
            3,
            4,
            5,
            6
          ],
          "default": 3
        }
      },
      "required": [
        "title"
      ]
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "The next step: usually one Button, optionally with a Link.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "discriminator": {
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "urn:strata:sdui:v1:node:Button"
            },
            {
              "$ref": "urn:strata:sdui:v1:node:Link"
            },
