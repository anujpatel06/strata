{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:strata:sdui:v1:node:EmptyState",
  "title": "EmptyState",
  "description": "What to show when there is nothing to show: no data yet, no results, or nothing left to do.",
  "x-strata": {
    "node": "EmptyState",
    "component": "empty-state",
    "export": "EmptyState",
    "maturity": "beta",
    "schemaVersion": "1.0.0",
    "source": "meta"
  },
  "type": "object",
  "required": [
    "type",
    "props"
  ],
  "properties": {
    "type": {
      "const": "EmptyState"
    },
    "id": {
      "$ref": "urn:strata:sdui:v1:defs#/$defs/NodeId"
