    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "x-strata-rule": {
        "id": "empty-state-title",
        "message": "An EmptyState needs props.title: it is the heading that says what is empty."
      },
      "type": "object",
      "required": [
        "props"
      ],
      "properties": {
        "props": {
          "type": "object",
          "required": [
            "title"
          ],
          "properties": {
            "title": {
