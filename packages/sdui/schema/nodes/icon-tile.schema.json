{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:syntara:sdui:v1:node:IconTile",
  "title": "IconTile",
  "description": "A rounded-square tile holding an icon or logo on a contrast-checked tint or the brand fill.",
  "x-syntara": {
    "node": "IconTile",
    "component": "icon-tile",
    "export": "IconTile",
    "maturity": "beta",
    "schemaVersion": "1.1.0",
    "source": "meta"
  },
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "const": "IconTile"
    },
    "id": {
      "$ref": "urn:syntara:sdui:v1:defs#/$defs/NodeId"
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "src": {
          "description": "An image (asset or merchant logo) instead of an icon.",
          "$ref": "urn:syntara:sdui:v1:defs#/$defs/ImageUrl"
        },
        "alt": {
          "description": "Accessible name. With src it's the image's alt; without, the tile gets role=\"img\". Omit it (and aria-label) when a visible label sits next to the tile: the tile is then aria-hidden.",
          "type": "string"
        },
        "tint": {
          "description": "solid = action.primary pair; tones = the same engine-checked bg/fg pairs as Avatar; auto = a stable tint from a hash of name (same hash as Avatar).",
          "type": "string",
          "enum": [
            "auto",
            "none",
            "solid",
            "brand",
            "accent",
            "info",
            "success",
            "warning",
            "danger"
          ]
        },
        "name": {
          "description": "Seed for tint=\"auto\" (falls back to alt).",
          "type": "string"
        },
        "size": {
          "description": "32, 40 or 48px.",
          "type": "string",
          "enum": [
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        }
      }
    },
    "children": {
      "description": "An icon from @syntara/icons. Sized to half the tile at the brand's icon stroke. On the wire: one { icon } reference.",
      "$ref": "urn:syntara:sdui:v1:defs#/$defs/IconRef"
    },
    "fallback": {
      "description": "Rendered instead of this node by a client that doesn't know its type. Must be a node that client knows.",
      "$ref": "urn:syntara:sdui:v1:screen#/$defs/Node"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "x-syntara-rule": {
        "id": "icon-tile-image-alt",
        "message": "An IconTile with props.src needs props.alt: the logo's name, or \"\" if the name is already next to it."
      },
      "type": "object",
      "if": {
        "type": "object",
        "required": [
          "props"
        ],
        "properties": {
          "props": {
            "type": "object",
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "type": "string"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "props"
        ],
        "properties": {
          "props": {
            "type": "object",
            "required": [
              "alt"
            ],
            "properties": {
              "alt": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
