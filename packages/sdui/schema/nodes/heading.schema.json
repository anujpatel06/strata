{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:strata:sdui:v1:node:Heading",
  "title": "Heading",
  "description": "A heading. Pick the level that fits the screen outline. The schema's own text node.",
  "x-strata": {
    "node": "Heading",
    "component": null,
    "export": null,
    "maturity": "alpha",
    "schemaVersion": "1.0.0",
    "source": "sdui"
  },
  "type": "object",
  "required": [
    "type",
    "children"
  ],
  "properties": {
    "type": {
      "const": "Heading"
    },
    "id": {
      "$ref": "urn:strata:sdui:v1:defs#/$defs/NodeId"
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "description": "Heading level, 1 to 6.",
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "default": 2
        },
        "size": {
          "description": "Font size token. Defaults by level: 1 → 2xl, 2 → xl, 3 and below → lg.",
          "type": "string",
          "enum": [
            "lg",
            "xl",
            "2xl",
            "3xl"
          ]
        }
      }
    },
    "children": {
      "description": "On the wire: a string.",
      "type": "string"
    },
    "fallback": {
      "description": "Rendered instead of this node by a client that doesn't know its type. Must be a node that client knows.",
      "$ref": "urn:strata:sdui:v1:screen#/$defs/Node"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "x-strata-rule": {
        "id": "heading-text",
        "message": "A Heading needs text: an empty heading is announced as a blank."
      },
      "type": "object",
      "required": [
        "children"
      ],
      "properties": {
        "children": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  ]
}
