{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:strata:sdui:v1:node:Inline",
  "title": "Inline",
  "description": "Lays out nodes in a row that wraps, with a token gap. Follows the reading direction. The schema's own layout node.",
  "x-strata": {
    "node": "Inline",
    "component": null,
    "export": null,
    "maturity": "alpha",
    "schemaVersion": "1.0.0",
    "source": "sdui"
  },
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "const": "Inline"
    },
    "id": {
      "$ref": "urn:strata:sdui:v1:defs#/$defs/NodeId"
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gap": {
          "description": "Space between items: a space token, or section-gap (which follows the client's density).",
          "$ref": "urn:strata:sdui:v1:defs#/$defs/Gap",
          "default": "space-2"
        },
        "align": {
          "description": "Cross-axis alignment.",
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "baseline",
            "stretch"
          ],
          "default": "center"
        },
        "justify": {
          "description": "Main-axis distribution. between pushes the first and last items to the edges.",
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "between"
          ],
          "default": "start"
        },
        "wrap": {
          "description": "Wrap onto more lines when the row is too narrow.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "children": {
      "description": "On the wire: an array of nodes, in order.",
      "type": "array",
      "items": {
        "$ref": "urn:strata:sdui:v1:screen#/$defs/Node"
      }
    },
    "fallback": {
      "description": "Rendered instead of this node by a client that doesn't know its type. Must be a node that client knows.",
      "$ref": "urn:strata:sdui:v1:screen#/$defs/Node"
    }
  },
  "additionalProperties": false
}
