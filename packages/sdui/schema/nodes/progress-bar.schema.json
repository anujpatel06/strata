{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:strata:sdui:v1:node:ProgressBar",
  "title": "ProgressBar",
  "description": "Shows how far a task has got, or that it is working when the duration is unknown.",
  "x-strata": {
    "node": "ProgressBar",
    "component": "progress",
    "export": "ProgressBar",
    "maturity": "beta",
    "schemaVersion": "1.0.0",
    "source": "meta"
  },
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "const": "ProgressBar"
    },
    "id": {
      "$ref": "urn:strata:sdui:v1:defs#/$defs/NodeId"
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "Visible label. Without one, pass aria-label or aria-labelledby (the types require one of the three).",
          "type": "string"
        },
        "value": {
          "description": "Current value, between minValue and maxValue.",
          "type": "number",
          "default": 0
        },
        "minValue": {
          "description": "Lowest value.",
          "type": "number",
          "default": 0
        },
        "maxValue": {
          "description": "Highest value.",
          "type": "number",
          "default": 100
        },
        "isIndeterminate": {
          "description": "Unknown duration: no value is announced and a segment slides along the track.",
          "type": "boolean",
          "default": false
        },
        "showValue": {
          "description": "Shows the formatted value at the inline end of the label row.",
          "type": "boolean",
          "default": false
        },
        "valueLabel": {
          "description": "Replaces the formatted value, e.g. '4.1 of 5 GB'.",
          "type": "string"
        },
        "tone": {
          "description": "Fill colour. default uses the brand accent.",
          "type": "string",
          "enum": [
            "default",
            "success",
            "warning",
            "danger"
          ],
          "default": "default"
        },
        "size": {
          "description": "Track thickness: 4px or 8px.",
          "type": "string",
          "enum": [
            "sm",
            "md"
          ],
          "default": "md"
        },
        "ariaLabel": {
          "description": "Accessible name, for when there is no visible label.",
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "fallback": {
      "description": "Rendered instead of this node by a client that doesn't know its type. Must be a node that client knows.",
      "$ref": "urn:strata:sdui:v1:screen#/$defs/Node"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "x-strata-rule": {
        "id": "progress-name",
        "message": "A ProgressBar needs a name: props.label (shown) or props.ariaLabel (read by screen readers only)."
      },
      "anyOf": [
        {
          "type": "object",
          "required": [
            "props"
          ],
          "properties": {
            "props": {
              "type": "object",
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "props"
          ],
          "properties": {
            "props": {
              "type": "object",
              "required": [
                "ariaLabel"
              ],
              "properties": {
                "ariaLabel": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
