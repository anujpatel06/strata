{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:strata:sdui:v1:node:CardTitle",
  "title": "CardTitle",
  "description": "The card's heading.",
  "x-strata": {
    "node": "CardTitle",
    "component": "card",
    "export": "CardTitle",
    "maturity": "beta",
    "schemaVersion": "1.0.0",
    "source": "meta"
  },
  "type": "object",
  "required": [
    "type",
    "children"
  ],
  "properties": {
    "type": {
      "const": "CardTitle"
    },
    "id": {
      "$ref": "urn:strata:sdui:v1:defs#/$defs/NodeId"
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "description": "Heading level. Pick the one that fits the page outline.",
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "default": 3
        }
      }
    },
    "children": {
      "description": "On the wire: a string.",
      "type": "string"
    },
    "fallback": {
      "description": "Rendered instead of this node by a client that doesn't know its type. Must be a node that client knows.",
      "$ref": "urn:strata:sdui:v1:screen#/$defs/Node"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "x-strata-rule": {
        "id": "card-title-text",
        "message": "A CardTitle needs text: an empty heading is announced as a blank."
      },
      "type": "object",
      "required": [
        "children"
      ],
      "properties": {
        "children": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  ]
}
