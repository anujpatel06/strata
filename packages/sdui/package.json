{
  "name": "@strata/sdui",
  "version": "0.0.0",
  "description": "Strata for server-driven UI: a JSON Schema per component generated from meta.json, a screen validator, and a reference renderer for the web.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./schema/*": "./schema/*",
    "./examples/*": "./examples/*"
  },
  "files": [
    "src",
    "schema",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.17.0"
  },
  "peerDependencies": {
    "@strata/icons": "workspace:*",
    "@strata/react": "workspace:*",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@strata/icons": "workspace:*",
    "@strata/react": "workspace:*",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.0"
  }
}
