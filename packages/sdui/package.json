{
  "name": "@syntara/sdui",
  "version": "0.1.1",
  "description": "Syntara for server-driven UI: a JSON Schema per component generated from meta.json, a screen validator, and a reference renderer for the web.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "server-driven-ui",
    "json-schema",
    "design-system",
    "renderer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anujpatel06/strata.git",
    "directory": "packages/sdui"
  },
  "homepage": "https://github.com/anujpatel06/strata/tree/main/packages/sdui#readme",
  "bugs": "https://github.com/anujpatel06/strata/issues",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./schema/*": "./schema/*",
    "./examples/*": "./examples/*"
  },
  "files": [
    "src",
    "schema",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.17.0"
  },
  "peerDependencies": {
    "@syntara/icons": ">=0.1.0 <1.0.0",
    "@syntara/react": ">=0.1.0 <1.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@syntara/icons": "workspace:*",
    "@syntara/react": "workspace:*",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.0"
  }
}
