{
  "name": "strata",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @strata/generator dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:themes": "pnpm --filter @strata/theme-engine fuzz",
    "typecheck": "pnpm -r typecheck",
    "tokens": "pnpm --filter @strata/tokens build",
    "screenshots": "node scripts/screenshots.mjs",
    "registry": "node packages/react/scripts/build-registry.mjs",
    "check:meta": "node packages/react/scripts/check-meta.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "playwright": "1.56.0",
    "@axe-core/playwright": "^4.10.0",
    "typescript": "~5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
